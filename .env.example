# gsc-hub настраивается через браузерный setup-визард при первом запуске —
# поднимите контейнер и откройте приложение, .env редактировать не обязательно.
# Переменные ниже — для автоматизированного / CI-деплоя (имеют приоритет над
# значениями, введёнными в визарде).

# Google OAuth (Web application client из Google Cloud Console)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Auth.js secret — если не задан, генерируется автоматически и хранится в БД.
# AUTH_SECRET=

# Trust proxy headers (needed behind a reverse proxy / TLS terminator)
AUTH_TRUST_HOST=true

# ── Optional ──
# Path to the SQLite file (default ./data/gsc-hub.db)
# DB_PATH=./data/gsc-hub.db

# Site Health tab — SSL works with no key; Safe Browsing + Core Web Vitals need a
# Google API key (enable "PageSpeed Insights API" and "Safe Browsing API"; one key
# works for both). The Health checks stay hidden until these are set.
# PAGESPEED_KEY=
# GOOGLE_SAFE_BROWSING_KEY=

# Bing Webmaster API key — enables Bing data + "Submit to Bing".
# BING_API_KEY=

# Concurrent Search Console calls per fan-out (default 8). Guards the local socket pool on
# large portfolios — unbounded, a ~200-site account times out the whole batch. Raise only if
# your host handles more sockets; lower it if you still see connect timeouts.
# GSC_CONCURRENCY=8

# Concurrent URL Inspection calls (default 4). Lower on purpose: inspection is capped by
# quota (2000/day and 600/min per property), not by sockets.
# GSC_INSPECT_CONCURRENCY=4

# ── Optional: multi-user login/roles (only if you expose the app beyond loopback) ──
# When ADMIN_EMAIL/ADMIN_PASSWORD are set, the app seeds an admin and requires login.
# Leave unset for the default single-user, loopback-only mode.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ORIGIN=https://your-domain.example      # public origin (enables secure cookies)
# AUTH_URL=https://your-domain.example    # must match the GCP OAuth redirect base
#
# EXPOSED_MODE decides whether the app may use its single-user shortcuts: the
# anonymous setup wizard, and passing every request as local admin when no login
# is configured. Both are safe only when nothing but this machine can reach it,
# so an exposed app with no login returns 503 instead.
#
# Left unset, it is inferred: the app is local only when both the configured
# origin (ORIGIN, else AUTH_URL) and the request's own host are loopback. A LAN
# address, a .local name, a VPN or an unset origin all count as exposed, because
# other machines can reach those.
#
# Set it explicitly when the inference cannot see the truth — a tunnel or a
# reverse proxy publishing the app under a name it was never told about:
# EXPOSED_MODE=1
# ...or to accept the risk on a network you trust, keeping single-user mode:
# EXPOSED_MODE=0
