# ── Required: Google OAuth (Web application client from Google Cloud Console) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth.js secret (generate: openssl rand -base64 32)
AUTH_SECRET=

# Trust proxy headers (needed behind a reverse proxy / TLS terminator)
AUTH_TRUST_HOST=true

# ── Optional ──
# Path to the SQLite file (default ./data/gsc-hub.db)
# DB_PATH=./data/gsc-hub.db

# Site Health tab — SSL works with no key; Safe Browsing + Core Web Vitals need a
# Google API key (enable "PageSpeed Insights API" and "Safe Browsing API"; one key
# works for both). The Health checks stay hidden until these are set.
# PAGESPEED_KEY=
# GOOGLE_SAFE_BROWSING_KEY=

# Bing Webmaster API key — enables Bing data + "Submit to Bing".
# BING_API_KEY=

# ── Optional: multi-user login/roles (only if you expose the app beyond loopback) ──
# When ADMIN_EMAIL/ADMIN_PASSWORD are set, the app seeds an admin and requires login.
# Leave unset for the default single-user, loopback-only mode.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ORIGIN=https://your-domain.example      # public origin (enables secure cookies)
# AUTH_URL=https://your-domain.example    # must match the GCP OAuth redirect base
